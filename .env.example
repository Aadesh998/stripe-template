# ---------------------------------------------------------------------------
# Stripe credentials (Dashboard -> Developers -> API keys)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Webhook signing secret (Dashboard -> Developers -> Webhooks -> your endpoint).
# When testing locally with the Stripe CLI, `stripe listen` prints a whsec_... to use.
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# ---------------------------------------------------------------------------
# Server / app config
# ---------------------------------------------------------------------------
# Default currency for ad-hoc Checkout / PaymentIntents (ISO 4217, lower-case).
STRIPE_CURRENCY=usd

# Where to send the browser after hosted Checkout. If unset, these are derived
# from FRONTEND_URL. SUCCESS_URL may contain the {CHECKOUT_SESSION_ID} placeholder.
# STRIPE_SUCCESS_URL=http://localhost:3000/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=http://localhost:3000/cancel

# Used for Billing Portal return + to derive the Checkout URLs above.
FRONTEND_URL=http://localhost:3000

# Port the example server listens on.
PORT=8080

# ---------------------------------------------------------------------------
# Subscription price mapping (internal "<plan>:<interval>" -> Stripe Price id).
# Create recurring Prices in the Dashboard (Products) and paste their ids here.
# ---------------------------------------------------------------------------
STRIPE_PRO_MONTHLY_PRICE_ID=price_xxxxxxxxxxxxx
STRIPE_PRO_QUARTERLY_PRICE_ID=price_xxxxxxxxxxxxx
STRIPE_PRO_YEARLY_PRICE_ID=price_xxxxxxxxxxxxx
